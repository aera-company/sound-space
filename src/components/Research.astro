---
import { Image } from 'astro:assets';
import ListeningRoom from './ListeningRoom.astro';
import warm from '../assets/warm2.jpg';
import cool from '../assets/cool2.jpg';
import lightWarm from '../assets/light-01-warm.jpg';
import lightBaseline from '../assets/light-02-baseline.jpg';
import lightCool from '../assets/light-03-cool.jpg';
import project00 from '../assets/project-00.jpg';
import project01 from '../assets/project-01.jpg';
import project02 from '../assets/project-02.jpg';
import project03 from '../assets/project-03.jpg';
import project04 from '../assets/project-04.jpg';
import project05 from '../assets/project-05.jpg';
import project06 from '../assets/project-06.jpg';
import project07 from '../assets/project-07.jpg';
import project08 from '../assets/project-08.jpg';
import project09 from '../assets/project-09.jpg';
import project10 from '../assets/project-10.jpg';
const conditions=[
 {id:'1',light:'warm',tempo:'slow',bpm:68},
 {id:'2',light:'warm',tempo:'fast',bpm:118},
 {id:'3',light:'cool',tempo:'slow',bpm:68},
 {id:'4',light:'cool',tempo:'fast',bpm:118},
];
const gallery=[
 {src:project00,alt:'Project documentation photograph 00 inside The Hanger UCL Store'},
 {src:project01,alt:'Project documentation photograph 01 inside The Hanger UCL Store'},
 {src:project02,alt:'Project documentation photograph 02 inside The Hanger UCL Store'},
 {src:project03,alt:'Project documentation photograph 03 inside The Hanger UCL Store'},
 {src:project04,alt:'Project documentation photograph 04 inside The Hanger UCL Store'},
 {src:project05,alt:'Project documentation photograph 05 inside The Hanger UCL Store'},
 {src:project06,alt:'The Hanger UCL Store under the baseline lighting condition'},
 {src:project07,alt:'The Hanger UCL Store under the cool lighting condition'},
 {src:project08,alt:'The Hanger UCL Store under the warm lighting condition'},
 {src:project09,alt:'Project documentation photograph 09 inside The Hanger UCL Store'},
 {src:project10,alt:'Project documentation photograph 10 inside The Hanger UCL Store'},
];
---

<section id="explore" class="explore-room wrap" aria-labelledby="explore-heading">
  <div class="section-line light-line"><span aria-hidden="true"></span><span>Four sensory conditions</span></div>
  <div class="explore-heading"><div><p class="eyebrow">UCL Store experiment</p><h2 id="explore-heading">Explore the experimental conditions</h2></div><p>Select a condition to change the lighting context and hear a 30-second excerpt of its musical tempo.</p></div>
  <div class="explore-stage" data-room-light="warm">
    <div class="room-media" aria-live="polite">
      <Image class="room-photo room-photo-warm" src={warm} alt="The UCL Store under warm lighting" widths={[800,1400,2000]} sizes="(max-width:760px) 100vw, 92vw" width={2000} height={1333} loading="lazy" />
      <Image class="room-photo room-photo-cool" src={cool} alt="The UCL Store under cool lighting" widths={[800,1400,2000]} sizes="(max-width:760px) 100vw, 92vw" width={2000} height={1333} loading="lazy" />
      <div class="room-light-label"><i aria-hidden="true"></i><span data-room-label>Warm light</span></div>
    </div>
    <div class="room-conditions" role="group" aria-label="Experimental conditions">
      {conditions.map(c=><button class="room-condition" data-combination={c.bpm} data-light={c.light} data-condition={c.id} aria-pressed="false" aria-label={`Play 30-second excerpt: Condition ${c.id}, ${c.light} light + ${c.bpm} BPM`}>
        <span class="condition-index">Condition {c.id}</span><strong>{c.light === 'warm'?'Warm':'Cool'} + {c.tempo === 'fast'?'Fast':'Slow'}</strong>
        <span class="condition-card-meta"><span>{c.bpm} BPM</span></span>
        <span class="sample-action" aria-hidden="true"><span class="sample-icon"><svg class="sample-play" viewBox="0 0 20 20" width="14" height="14"><path d="M5 3v14l12-7Z" fill="currentColor" /></svg><svg class="sample-stop" viewBox="0 0 20 20" width="14" height="14"><path d="M4 4h12v12H4Z" fill="currentColor" /></svg></span><span class="sample-text">Listen · 30 sec</span></span><span class="sample-progress" aria-hidden="true"></span>
      </button>)}
    </div>
  </div>
  <div class="room-status"><p id="matrix-status" role="status">Choose a condition to change the room and hear its soundtrack.</p><button id="sample-stop" hidden>Stop excerpt</button><span>Sound / light / people / space</span></div>
  <p class="matrix-note">Field photographs document the lighting conditions. Screen colour does not reproduce calibrated lighting.</p>
</section>

<section id="light" class="light-study wrap" aria-labelledby="light-heading">
  <div class="section-line light-line"><span>03 · Light study</span><span>Warm / neutral / cool</span></div>
  <div class="light-study-heading"><h2 id="light-heading">Lightning</h2><p>The store shifts in atmosphere while its architecture stays constant. Three field views hold that change side by side.</p></div>
  <div class="light-triptych">
    <figure><div><Image src={lightWarm} alt="The store under warm light" widths={[480,800]} sizes="(max-width:760px) 86vw, 31vw" width={1568} height={1515} loading="lazy" /></div><figcaption><span>01</span><strong>Warm</strong><small>Lower colour temperature</small></figcaption></figure>
    <figure><div><Image src={lightBaseline} alt="The store under baseline light" widths={[480,800]} sizes="(max-width:760px) 86vw, 31vw" width={1568} height={1515} loading="lazy" /></div><figcaption><span>02</span><strong>Neutral</strong><small>Baseline condition</small></figcaption></figure>
    <figure><div><Image src={lightCool} alt="The store under cool light" widths={[480,800]} sizes="(max-width:760px) 86vw, 31vw" width={1568} height={1515} loading="lazy" /></div><figcaption><span>03</span><strong>Cool</strong><small>Higher colour temperature</small></figcaption></figure>
  </div>
</section>

<ListeningRoom />

<section id="film" class="project-film wrap" aria-labelledby="film-heading">
  <div class="section-line light-line"><span>Moving light</span><span>Warm / neutral / cool</span></div>
  <div class="film-heading"><div><p class="eyebrow">The space in transition</p><h2 id="film-heading">A different tempo<br />A different light<br />The same space</h2></div><p>A silent study of the same retail setting as its colour temperature shifts.</p></div>
  <figure class="field-film"><video id="field-film" muted playsinline loop controls preload="metadata" poster={lightBaseline.src} width="1024" height="576" aria-label="Silent video showing changes in the store's lighting temperature"><source src="/video/new-video.mp4" type="video/mp4" /></video><figcaption><span>The Hanger · UCL Store</span><span>Silent film · 0:18</span></figcaption></figure>
</section>

<section id="gallery" class="project-gallery" aria-labelledby="gallery-heading">
  <div class="wrap"><div class="section-line light-line"><span>05 · Project in view</span><span>Field documentation</span></div><div class="gallery-heading"><div><p class="eyebrow">Inside the study</p><h2 id="gallery-heading">Project in view</h2></div><p>Eleven details from the UCL Store, including the space, its lighting and the environmental measurements.</p></div></div>
  <div class="gallery-shell">
    <div class="gallery-viewport" data-gallery tabindex="0" aria-label="Project photo gallery">
      {gallery.map((item,i)=><figure class="gallery-slide" data-gallery-slide aria-label={`Photo ${i+1} of ${gallery.length}`}><Image src={item.src} alt={item.alt} widths={[640,1000,1600,2200]} sizes="(max-width:760px) 75vw, 66vw" loading="lazy" /><figcaption><span>{String(i).padStart(2,'0')} / 10</span><span>Field documentation · The Hanger</span></figcaption></figure>)}
    </div>
    <div class="gallery-controls wrap"><div class="gallery-buttons"><button type="button" data-gallery-prev aria-label="Previous photograph">←</button><button type="button" data-gallery-next aria-label="Next photograph">→</button></div><div class="gallery-dots" role="group" aria-label="Choose photograph">{gallery.map((_,i)=><button type="button" data-gallery-dot={i} aria-label={`Show photograph ${i+1}`} aria-pressed={i===0?'true':'false'}></button>)}</div><p class="gallery-status" aria-live="polite">Photograph <span data-gallery-current>1</span> of {gallery.length}</p></div>
  </div>
</section>

<footer class="footer wrap" id="credits">
  <a class="footer-title" href="#listen">Return to listening <span aria-hidden="true">↗</span></a>
  <div class="footer-credits"><p><strong>Research &amp; credits</strong><span>Module BENV0008 · Dissertation 25/26 · Student WHBQ3</span></p><p><strong>Supervisors</strong><span>Dr. Prof. Francesco Aletta<br />Dr. Prof. Gemma Moore</span></p><p><strong>Programme</strong><span>MSc Health, Wellbeing and Sustainable Buildings<br />UCL Institute for Environmental Design &amp; Engineering</span></p></div>
  <div class="footer-meta"><span>BENV0008 25/26 <strong>WHBQ3</strong></span><span>UCL · MSc dissertation · 2026</span><a href="#top">Back to top ↑</a></div>
</footer>
