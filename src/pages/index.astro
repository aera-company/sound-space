---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import ListeningRoom from "../components/ListeningRoom.astro";
import Research from "../components/Research.astro";
import { Image } from "astro:assets";
import hero from "../assets/hero.png";
---

<Layout title="Soundscape and Lighting in Retail Environments — BENV0008 25/26 · UCL" description="A small-scale pilot study in the UCL Store investigating soundscape, lighting, customer behaviour and spatial experience.">
  <a class="skip-link" href="#listen">Skip to listening</a>
  <Masthead />
  <main id="main">
    <section class="hero project-cover" aria-labelledby="page-title">
      <div class="cover-index wrap">
        <p><strong>Module BENV0008</strong><span>Dissertation 25/26</span></p>
        <p><span>Student</span><strong>WHBQ3</strong></p>
      </div>
      <div class="hero-photo cover-visual"><Image src={hero} alt="Inside The Hanger UCL Store, the setting for the sound and lighting study" widths={[640,1024,1448]} sizes="100vw" width={1448} height={1086} loading="eager" fetchpriority="high" /></div>
      <div class="cover-body wrap">
        <div class="cover-title">
          <p class="cover-context">MSc Health, Wellbeing and Sustainable Buildings</p>
          <h1 id="page-title">The Influence of Soundscape and Lighting on Customer Behaviour and Spatial Experience in Retail Environments</h1>
          <p class="cover-subtitle">A small-scale pilot study in the UCL Store — The Hanger</p>
        </div>
      </div>
      <div class="cover-footer wrap">
        <div class="cover-institution"><strong>University College London</strong><span>UCL Institute for Environmental Design &amp; Engineering</span></div>
        <dl class="cover-supervisors"><div><dt>1st Supervisor</dt><dd>Dr. Prof. Francesco Aletta</dd></div><div><dt>2nd Supervisor</dt><dd>Dr. Prof. Gemma Moore</dd></div></dl>
        <a href="#listen" class="cover-entry">Listen to the two conditions <span aria-hidden="true">↓</span></a>
      </div>
    </section>
    <ListeningRoom />
    <Research />
  </main>
  <script>import '../scripts/audio.ts';import '../scripts/polish.ts';</script>
</Layout>
